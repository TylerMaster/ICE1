    public abstract class Employee
    {
        protected string firstName;
        protected string lastName;
        protected int employeeID;


        protected EmployeeType employeeType;



        public Employee(string firstName, string lastName, int employeeID, EmployeeType employeeType)
        {
            this.firstName = firstName;
            this.lastName = lastName;
            this.employeeID = employeeID;
            this.employeeType = employeeType;
        }

        public abstract double GrossEarnings { get; }
        public double Tax { get => Math.Round(this.GrossEarnings * 0.20, 2); }
        public double NetEarnings { get => Math.Round(this.GrossEarnings - this.Tax,2); }

        public EmployeeType GetEmployeeType { get => this.employeeType; }

        public string FirstName { get => this.firstName; set => this.firstName = value; }
        public string LastName { get => this.lastName; set => this.lastName = value; }

        public int EmployeeID { get => this.employeeID; }





        public override string ToString()
        {
            return $"Employee ID: {employeeID}, Last Name: {lastName}, First Name: {firstName}";
        }


    }



    public class SalariedEmployee : Employee
    {

        private double weeklySalary;
        public override double GrossEarnings
        {
            get { return weeklySalary; }
        }



        public SalariedEmployee(string firstName, string lastName, int employeeID, EmployeeType employeeType, double weeklySalary) : base(firstName, lastName, employeeID, employeeType)
        {
            {
                this.weeklySalary = weeklySalary;
            }
        }

        public double WeeklySalary { get => this.weeklySalary; set => this.weeklySalary = value; }



        public override string ToString()
        {
            return base.ToString() + $", Weekly Salary: {weeklySalary:C}";
        }
    }

    public class CommissionEmployee : Employee
    {

        protected double grossSales;
        protected double commissionRate;

        public override double GrossEarnings
        {
            get => Math.Round(grossSales * (commissionRate / 100), 2);
        }

        public CommissionEmployee(string firstName, string lastName, int employeeID, EmployeeType employeeType, double grossSales, double commissionRate)
      : base(firstName, lastName, employeeID, employeeType)
        {
            this.grossSales = grossSales;
            this.commissionRate = commissionRate;
        }
        public double GrossSales { get => this.grossSales; set => this.grossSales = value; }
        public double CommissionRate { get => this.commissionRate; set => this.commissionRate = value; }

    }

    public class HourlyEmployee : Employee
    {
        private double hourlyWage;
        private double hoursWorked;


        public HourlyEmployee(string firstName, string lastName, int employeeID, EmployeeType employeeType, double hourlyWage, double hoursWorked)
        : base(firstName, lastName, employeeID, employeeType)
        {
            this.hourlyWage = hourlyWage;
            this.hoursWorked = hoursWorked;
        }

        public override double GrossEarnings
        {
            get => (hoursWorked <= 40)
                ? hourlyWage * hoursWorked
                : (40 * hourlyWage) + ((hoursWorked - 40) * hourlyWage * 1.5);
        }

        public double HourlyWage { get => this.hourlyWage; set => this.hourlyWage = value;}
        public double HoursWorked { get => this.hoursWorked; set => this.hoursWorked = value; }

        public override string ToString()
        {
            return base.ToString() + $", Hourly Wage: {hourlyWage:C}, Hours Worked: {hoursWorked}";
        }

    }


    public class SalaryPlusCommissionEmployee : CommissionEmployee
    {
        private double baseSalary;


        public SalaryPlusCommissionEmployee(string firstName, string lastName, int employeeID, EmployeeType employeeType, double grossSales, double commissionRate, double baseSalary)
         : base(firstName, lastName, employeeID, employeeType, grossSales, commissionRate)
        {
            this.baseSalary = baseSalary;
        }

        public override double GrossEarnings
        {
            get => Math.Round(baseSalary + (grossSales * (commissionRate / 100)), 2);
        }

        public double BaseSalary { get  => this.baseSalary; set => this.baseSalary = value; }


        public override string ToString()
        {
            return base.ToString() + $", Base Salary: {baseSalary:C}";
        }
    }

