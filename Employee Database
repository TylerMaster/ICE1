    public static int GenerateID(Dictionary<int, Employee> employees)
    {
        var rand = new Random();
        int generatedNumber = rand.Next(0, 10000);
        int result = Search(employees, generatedNumber);

        if (result > 0)
        {
            do
            {

                generatedNumber = rand.Next(0, 10000);
                result = Search(employees, generatedNumber);
                if (result == 0)
                {
                    break;
                }
            } while (result > 0);
        }
        return generatedNumber;
    }

    public static int Search(Dictionary<int, Employee> employees, int key)
    {
