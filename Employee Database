    public static string FormToAddEmployeeFirstName(Dictionary<int, Employee> employees)
    {
        Console.WriteLine("FirstName? (only A-Z and a-z allowed): ");
        string firstName;
        bool validInput = false;
        do
        {
            firstName = Console.ReadLine();

            foreach (char c in firstName)
            {
                int asciiValue = (int)c;

                if (!(asciiValue >= 65 && asciiValue <= 90 || asciiValue >= 97 && asciiValue <= 122))
                {
                    validInput = false;
                    Console.WriteLine("Invalid Input");
                    Console.WriteLine("FirstName? (only A-Z and a-z allowed): ");
                    break;
                }
                else
                {
                    validInput = true;

                }
            }


        } while (validInput == false);
        return firstName;
    }

    public static string NumericStringValidator(int low, int high)
    {
        string number;
        bool validInput = false;
        do
        {
            number = Console.ReadLine();
            foreach (char c in number)
            {
                int asciiValue = (int)c;
                if (asciiValue < low || asciiValue > high)
                {
                    validInput = false;
                    Console.WriteLine("Invalid Input");
                    Console.WriteLine("Only Type numbers please.");
                    break;
                }
                else
                {
                    validInput = true;

                }
            }

        } while (validInput == false);
        return number;
    }
    public static void Search(Dictionary<int, Employee> employees)
    {

        int hourlyCount = 0;
        int salaryCount = 0;
        int commissionCount = 0;
        int salaryPlusCommissionCount = 0;

        ConsoleTable tableHourlyEmployee = new ConsoleTable("Id", "First Name", "Last Name", "Hours Worked", "Hourly Wage", "Net Earning", "Tax (20%)", "Net Earnings");
        ConsoleTable tableSalariedEmployee = new ConsoleTable("Id", "First Name", "Last Name", "Salary", "Gross Earnings", "Tax (20%)", "Net Earnings");
        ConsoleTable tableSalaryPlusCommissionEmployee = new ConsoleTable("Id", "First Name", "Last Name", "Salary", "Gross Sales", "Commission Rate", "Gross Earnings", "Tax (20%)", "Net Earnings");
        ConsoleTable tableCommissionEmployee = new ConsoleTable("Id", "First Name", "Last Name", "Gross Sales", "Commission Rate", "Gross Earning", "Tax (20%)", "Net Earnings");

        Console.WriteLine("Enter Employee name to search: ");
        string input = Console.ReadLine()?.ToLower();

        foreach (KeyValuePair<int, Employee> item in employees)
        {
            if (item.Value.FirstName.ToLower().Contains(input))
            {
                if (item.Value is HourlyEmployee hourlyEmployee)
                {
                    ++hourlyCount;
                    tableHourlyEmployee.AddRow(hourlyEmployee.EmployeeID, hourlyEmployee.FirstName, hourlyEmployee.LastName, hourlyEmployee.HoursWorked, hourlyEmployee.HourlyWage, ("$" + hourlyEmployee.GrossEarnings), ("$" + hourlyEmployee.Tax), ("$" + hourlyEmployee.NetEarnings));

                }

                if (item.Value is SalariedEmployee salaryEmployee)
                {
                    ++salaryCount;
                    tableSalariedEmployee.AddRow(salaryEmployee.EmployeeID, salaryEmployee.FirstName, salaryEmployee.LastName, ("$" + salaryEmployee.GrossEarnings), ("$" + salaryEmployee.GrossEarnings), ("$" + salaryEmployee.Tax), ("$" + salaryEmployee.NetEarnings));

                }

                if (item.Value is SalaryPlusCommissionEmployee salaryPlusCommissionEmployee)
                {
                    if (salaryPlusCommissionEmployee.GetEmployeeType == EmployeeType.SalariedPlusCommissionEmployee)
                    {
                        ++salaryPlusCommissionCount;
                        tableSalaryPlusCommissionEmployee.AddRow(salaryPlusCommissionEmployee.EmployeeID, salaryPlusCommissionEmployee.FirstName, salaryPlusCommissionEmployee.LastName, ("$" + salaryPlusCommissionEmployee.BaseSalary), ("$" + salaryPlusCommissionEmployee.GrossSales), (salaryPlusCommissionEmployee.CommissionRate + "%"), ("$" + salaryPlusCommissionEmployee.GrossEarnings), ("$" + salaryPlusCommissionEmployee.Tax), ("$" + salaryPlusCommissionEmployee.NetEarnings));
                    }
                }

                if (item.Value is CommissionEmployee commissionEmployee)
                {

                    if (commissionEmployee.GetEmployeeType == EmployeeType.CommissionEmployee)
                    {
                        ++commissionCount;
                        tableCommissionEmployee.AddRow(commissionEmployee.EmployeeID, commissionEmployee.FirstName, commissionEmployee.LastName, ("$" + commissionEmployee.GrossSales), (commissionEmployee.CommissionRate + "%"), ("$" + commissionEmployee.GrossEarnings), ("$" + commissionEmployee.Tax), ("$" + commissionEmployee.NetEarnings));
                    }
                }
            }
        }


        if (hourlyCount > 0)
        {
            Console.ForegroundColor = ConsoleColor.Yellow;
            Console.WriteLine("Hourly Employees: ");
            tableHourlyEmployee.Write();
            Console.ResetColor();
        }
        

        if (salaryCount > 0)
        {
            Console.ForegroundColor = ConsoleColor.Blue;
            Console.WriteLine("Salaried Employees: ");
            tableSalariedEmployee.Write();
            Console.ResetColor();
        }
       

        if (salaryPlusCommissionCount > 0)
        {
            Console.ForegroundColor = ConsoleColor.Green;
            Console.WriteLine("Salary Plus Commission Employees: ");
            tableSalaryPlusCommissionEmployee.Write();
            Console.ResetColor();
        }
        

        if (commissionCount > 0)
        {
            Console.ForegroundColor = ConsoleColor.Red;
            Console.WriteLine("Commission Employees: ");
            tableCommissionEmployee.Write();
            Console.ResetColor();
        }
        if (commissionCount == 0 && salaryCount == 0 && salaryPlusCommissionCount == 0 && hourlyCount == 0)
        {
            Console.WriteLine("No matches found.");
        }

        Console.WriteLine("Press enter to continue: ");
        string input3 = Console.ReadLine();
        Console.Clear();
        MainMenu(employees);


    }
