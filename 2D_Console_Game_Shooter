void EnemyMonster::SetCoordinates(char input, int setting, int mode) {

    if (input == 'x') {
        cd.xCoordinate = setting;
    }

    if (input == 'y') {
        cd.yCoordinate = setting;
    }

    if (input == 'x' && mode == 1) {
        cd._x_Plus = setting + 1;
    }
    if (input == 'y' && mode == 1) {
        cd._y_Plus = setting + 1;
    }

    if (input == 'x' && mode == 2) {
        cd._x_Negation = setting - 1;
    }

    if (input == 'y' && mode == 2) {
        cd._y_Negation = setting - 1;
    }
}

