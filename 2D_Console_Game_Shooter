    if (monster2->moveCounterAi >= monster2->moveLengthGen) {
        monster2->moveCycle = false;
        monster2->moveLengthGen = 0;
        monster2->moveDirectionGen = 0;
        monster2->moveCounterAi = 0;
    }

}


