        setCoordinateDirection = direction_X;
    }
    if (yOrX == 1) {
        setCoordinateDirection = direction_Y;
    }

    if (monster2->moveCounterAi < monster2->moveLengthGen) {
        if (mapArray[direction_X][direction_Y] != '#' && mapArray[direction_X][direction_Y] != '@') {
            mapArray[direction_X][direction_Y] = '$';

            mapArray[monster2->GetCoordinates().xCoordinate][monster2->GetCoordinates().yCoordinate] = '.';

            monster2->SetCoordinates(setCoordinate, setCoordinateDirection, 0);
            ++monster2->moveCounterAi;

        }
        if (mapArray[direction_X][direction_Y] == '#') {
            monster2->moveCycle = false;
            monster2->moveLengthGen = 0;
            monster2->moveDirectionGen = 0;
            monster2->moveCounterAi = 0;
        }


