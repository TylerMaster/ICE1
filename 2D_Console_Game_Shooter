            int M = 4;
            int N = 7;
            pair.second->moveDirectionGen = rand() / (RAND_MAX / M + 1) + 1;
            pair.second->moveLengthGen = rand() / (RAND_MAX / N + 1) + 1;
            pair.second->moveCycle = true;
        }
