Player* BulletAi(Player* playerPtr, BulletUnitMap& monsterBulletUnitMap, BulletUnitMap& playerBulletUnitMap, DroneMonsterUnitMap& unitMap, char mapArray[12][53], char* inputChar, bool destroy, int& bulletUnitId, int& bulletCount, steady_clock::time_point& lastTime, duration<double> interval ) {
    

    auto now = steady_clock::now();
    auto elapsed = now - lastTime;
    for (auto& pair : unitMap) {

        int result = playerPtr->GetCoordinates().yCoordinate - pair.second->GetCoordinates().yCoordinate;
        int invert = 0;

        if (result < 0) {
            result = (result * -1);
            invert = 1;
            
        }
        //HANDLES FIRING
        if (result <= 15) {
            if (elapsed >= interval) {
                ++bulletCount;
                ++bulletUnitId;
                DroneMonster* droneMonsterPtr;
                droneMonsterPtr = static_cast<DroneMonster*>(pair.second);

                addBulletUnit(bulletUnitId, new Bullet(droneMonsterPtr->weapon, NULL, pair.second, FALSE, inputChar, destroy, bulletUnitId), monsterBulletUnitMap);



                if (monsterBulletUnitMap[bulletUnitId]->_progressing == false && monsterBulletUnitMap[bulletUnitId] != NULL) {
                    monsterBulletUnitMap[bulletUnitId]->_x = pair.second->GetCoordinates().xCoordinate;
                    monsterBulletUnitMap[bulletUnitId]->_y = pair.second->GetCoordinates().yCoordinate;
                    monsterBulletUnitMap[bulletUnitId]->_progressing = true;
                    monsterBulletUnitMap[bulletUnitId]->invert_Shot = invert;

                    lastTime = now;
                }
            }
        }
    }

            //HANDLES MOVING
    if (!monsterBulletUnitMap.empty()) {
        for (auto& pair : monsterBulletUnitMap) {
            if (pair.second->_progressing == true) {

                pair.second->_y_Plus = pair.second->_y + 1;
                pair.second->_y_Negation = pair.second->_y - 1;

                //projectile movement left
                if (pair.second->invert_Shot == 1 && mapArray[pair.second->_x][pair.second->_y_Negation] != '#' && mapArray[pair.second->_x][pair.second->_y_Negation] != '@') {
                    mapArray[pair.second->_x][pair.second->_y_Negation] = 'o';

                    if (mapArray[pair.second->_x][pair.second->_y] != '$') {
                        mapArray[pair.second->_x][pair.second->_y] = '.';

                    }

                    pair.second->_y = pair.second->_y - 1;
                }

                //Projectile movement right
                if (pair.second->invert_Shot == 0 && mapArray[pair.second->_x][pair.second->_y_Plus] != '#' && mapArray[pair.second->_x][pair.second->_y_Plus] != '@') {
                    mapArray[pair.second->_x][pair.second->_y_Plus] = 'o';

                    if (mapArray[pair.second->_x][pair.second->_y] != '$') {
                        mapArray[pair.second->_x][pair.second->_y] = '.';

                    }

                    pair.second->_y = pair.second->_y + 1;
                }

                //Hit Wall Left side
                if (pair.second->invert_Shot == 1 && mapArray[pair.second->_x][pair.second->_y_Negation] == '#') {
                    mapArray[pair.second->_x][pair.second->_y] = '.';

                    pair.second->_progressing = false;

                    pair.second->_destroy = true;



                }
                //Hit Wall Right side
                if (pair.second->invert_Shot == 0 && mapArray[pair.second->_x][pair.second->_y_Plus] == '#') {
                    mapArray[pair.second->_x][pair.second->_y] = '.';

                    pair.second->_progressing = false;

                    pair.second->_destroy = true;



                }

                //player hit Left side
                if (pair.second->invert_Shot == 1 && mapArray[pair.second->_x][pair.second->_y_Negation] == '@') {
                    if (mapArray[pair.second->_x][pair.second->_y] != '$') {
                        mapArray[pair.second->_x][pair.second->_y] = '.';
                    }

                    pair.second->_progressing = false;

                    pair.second->_destroy = true;


                    if (playerPtr->GetCoordinates().xCoordinate == pair.second->_x && playerPtr->GetCoordinates().yCoordinate == pair.second->_y_Negation) {
                        playerPtr->health = playerPtr->health - 50;
                        if (playerPtr->health == 0) {
                            mapArray[pair.second->_x][pair.second->_y_Negation] = '.';
                            

                            pair.second->_progressing = false;

                            pair.second->_destroy = true;

                            delete playerPtr;
                            playerPtr = NULL;
                            return playerPtr;

                            
                        }
                    }
                }

                //player hit Right side
                if (pair.second->invert_Shot == 0 && mapArray[pair.second->_x][pair.second->_y_Plus] == '@') {
                    if (mapArray[pair.second->_x][pair.second->_y] != '$') {
                        mapArray[pair.second->_x][pair.second->_y] = '.';
                    }

                    pair.second->_progressing = false;


                    pair.second->_destroy = true;

                    if (playerPtr->GetCoordinates().xCoordinate == pair.second->_x && playerPtr->GetCoordinates().yCoordinate == pair.second->_y_Plus) {
                        playerPtr->health = playerPtr->health - 50;
                        if (playerPtr->health == 0) {
                            mapArray[pair.second->_x][pair.second->_y_Plus] = '.';
                           

                            pair.second->_progressing = false;

                            pair.second->_destroy = true;
                            delete playerPtr;
                            playerPtr = NULL;
                            return playerPtr;

                            
                        }
                    }
                }
            }

        }

    }
     
    return playerPtr;
    
}

