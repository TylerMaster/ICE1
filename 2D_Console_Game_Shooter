            if (*myChar != 'e' && *myChar != 'q') {
                *myChar = ' ';
            }

            playerPtr = MoveAi(droneMonsterUnitMap, mapArray, playerPtr);
            if (playerPtr == NULL) {
                ClearPointers(droneMonsterUnitMap, bulletUnitMap, monsterBulletUnitMap);
                break;

            }

            lastTime_MoveLoop = now_MoveLoop;
        }
        
        
            if (*myChar == 'e' || *myChar == 'q') {
                shoot_Flag = playerPtr->Shoot(myChar);

            }
      
        // Projectile Speed
      
           if (shoot_Flag == true) {

               if (newInput == true) {
                   ++bulletCount;
                   ++bulletUnitId;
                   addBulletUnit(bulletUnitId, new Bullet(playerPtr->weapon, playerPtr, NULL, shoot_Flag, myChar, destroy, bulletUnitId), bulletUnitMap);
                   newInput = false;
               }
           }
               if (!bulletUnitMap.empty()) {
                   for (auto& pair : bulletUnitMap) {
                       
                       MoveBullet(playerPtr, pair.second, droneMonsterUnitMap, mapArray, myChar);
                       
                   }
               }
               if (!FindBullet(mapArray)) {
                   shoot_Flag = false;
               }
               //-----------------------------------------------------
               //player bullet delete
               bool erase = false;
               int bulletId = 0;
            
             BulletDelete(bulletUnitMap, erase, bulletId);

            playerPtr = BulletAi(playerPtr, monsterBulletUnitMap, bulletUnitMap, droneMonsterUnitMap, mapArray, NULL, monster_Destroy, monster_BulletUnitId, monster_BulletCount, lastTime_MonsterShotLoop, interval_MonsterShotLoop);
             if (playerPtr != NULL) {
                 cout << "PLAYER HEALTH: " << playerPtr->health << endl;
                 cout << "PLAYER WEAPON: " << playerPtr->weapon << endl;
             }
            //----------------------------------------------------- 
             //Monster bullet delete
             bool monster1_Erase = false;
             int monster1_BulletId = 0;
             BulletDelete(monsterBulletUnitMap, monster1_Erase, monster1_BulletId);

            
             if (playerPtr == NULL) {
                 ClearPointers(droneMonsterUnitMap, bulletUnitMap, monsterBulletUnitMap);

                 break;

             }
         
        
        std::this_thread::sleep_for(milliseconds(30));
        

    }
